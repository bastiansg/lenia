{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build lenia (release)",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build", "build",
                "--target", "lenia"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$gcc"],
        },
        {
            "label": "build leniadb (debug)",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build", "build",
                "--target", "leniadb"
            ],
            "group": "build",
            "problemMatcher": ["$gcc"],
        }
    ]
}