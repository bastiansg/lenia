{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build lenia (release)",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build",
                "build",
                "--target",
                "lenia",
                "-j20",
                "--",
                "-output-sync=target"
            ],
            "group": {
                "kind": "build",
            },
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "label": "build leniadb (debug)",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build",
                "build",
                "--target",
                "leniadb",
                "-j",
                "--",
                "-output-sync=target"
            ],
            "group": {"kind": "build", "isDefault": true,},
            "problemMatcher": [
                "$gcc"
            ]
        }
    ]
}