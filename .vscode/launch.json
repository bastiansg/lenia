{
    // Use IntelliSense for auto-completion and hover support.
    "version": "0.2.0",
    "configurations": [
        {
            "name": "launch lenia",
            "request": "launch",
            "type": "cppdbg",
            "program": "${workspaceFolder}/bin/lenia.exe",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": true,
            "preLaunchTask": "build",
        },
        {
            "name": "(gdb) debug lenia",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/bin/leniadb.exe",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": true,
            "MIMode": "gdb",
            "miDebuggerPath": "gdb.exe",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "build debug",
            "logging": {
                "engineLogging": false,
                "trace": false,
                "traceResponse": false
            }
        }
    ]
}