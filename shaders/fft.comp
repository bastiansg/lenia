#version 430

layout(local_size_x = 16, local_size_y = 16) in;

layout(binding = 0, rgba32f) readonly uniform image2D inputTexture;
layout(binding = 1, rgba32f) writeonly uniform image2D outputTexture;

uniform int direction; // 0 for row-wise, 1 for column-wise
uniform int size;      // Size of the FFT (width or height)

const float PI = 3.14159265359;

void main() {
    ivec2 gid = ivec2(gl_GlobalInvocationID.xy); // Global ID for workgroup
    if (gid.x >= size || gid.y >= size) return;

    vec2 sum = vec2(0.0, 0.0);

    for (int k = 0; k < size; k++) {
        // Read input based on FFT direction
        vec4 inputTexel = direction == 0 
                          ? imageLoad(inputTexture, ivec2(k, gid.y)) 
                          : imageLoad(inputTexture, ivec2(gid.x, k));
                          
        vec2 inputComplex = vec2(inputTexel.r, inputTexel.g); // (real, imag)
        
        // Calculate twiddle factor
        float angle = -2.0 * PI * float(k) * float(direction == 0 ? gid.x : gid.y) / float(size);
        vec2 twiddle = vec2(cos(angle), sin(angle));
        
        // Accumulate FFT results
        sum += vec2(
            inputComplex.x * twiddle.x - inputComplex.y * twiddle.y, // Real part
            inputComplex.x * twiddle.y + inputComplex.y * twiddle.x  // Imaginary part
        );
    }

    // Write the result back to the output texture
    imageStore(outputTexture, gid, vec4(sum, 0.0, 1.0));
}